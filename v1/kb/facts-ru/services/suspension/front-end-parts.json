 "list_items": [
  {
   "section": "Детали передней подвески",
   "item": "Стойки стабилизатора — самое дешёвое и самое частое: дробный стук на мелких неровностях. Меняем обе."
  },
  {
   "section": "Детали передней подвески",
   "item": "Люфт в рулевом наконечнике или шаровой — это безопасность. Так и говорим, один раз и без драмы: «Это шарнир, который поворачивает колесо. Я бы с таким не ездила»."
  },
  {
   "section": "Детали передней подвески",
   "item": "На многих машинах шаровая идёт вместе с рычагом. Тогда работа — рычаг, а строка шаровой не нужна."
  },
  {
   "section": "Детали передней подвески",
   "item": "Ко всему, где стоит «Да», добавляйте сход-развал, 3 000 ₽. Одна регулировка закрывает всё, что сделано за этот заезд."
  },
  {
   "section": "Детали передней подвески",
   "item": "Стандарт — CTR. На машине с пробегом за двести тысяч оригинал никому не навязываем."
  }
 ],
