 "list_items": [
  {
   "section": "Замена",
   "item": "Полярность и размер смотрим по старому аккумулятору, а не по каталогу. На машине может стоять не родной."
  },
  {
   "section": "Замена",
   "item": "Машинам со «старт-стоп» — EFB или AGM. Это не допродажа, это правильная деталь."
  },
  {
   "section": "Замена",
   "item": "На части новых машин аккумулятор нужно прописать сканером. Это входит в работу."
  },
  {
   "section": "Замена",
   "item": "Старый аккумулятор забираем на утилизацию. Клиент за это не платит."
  },
  {
   "section": "Замена",
   "item": "Гарантия — производителя, по талону. Обращение оформляем мы."
  },
  {
   "section": "Замена",
   "item": "Аккумулятор исправен, а стартер всё равно крутит вяло: Генератор и стартер."
  }
 ],
