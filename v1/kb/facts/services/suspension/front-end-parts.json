 "list_items": [
  {
   "section": "Front-end parts",
   "item": "Links are the cheap, common one: a rattle over small bumps. Replace both."
  },
  {
   "section": "Front-end parts",
   "item": "A loose tie rod or ball joint is a safety item. Say so in those words, once, without drama: \"This is the joint that steers the wheel. I would not leave it.\""
  },
  {
   "section": "Front-end parts",
   "item": "On many cars the ball joint comes with the control arm; then the arm is the job and the ball joint line is not used."
  },
  {
   "section": "Front-end parts",
   "item": "Add the alignment, $119.95, to anything marked Yes. One alignment covers everything done that visit."
  },
  {
   "section": "Front-end parts",
   "item": "Standard is Moog. On a car over 150,000 miles, do not talk anyone into the original part."
  }
 ],
