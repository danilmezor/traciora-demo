 "list_items": [
  {
   "section": "Filters and wipers",
   "item": "Show the old one. A grey cabin filter full of leaves sells itself. A clean one means we do not recommend it, and the customer remembers that we did not."
  },
  {
   "section": "Filters and wipers",
   "item": "Cabin filter: every 15,000 to 30,000 miles, sooner for anyone who parks under trees. If the A/C smells, this first."
  },
  {
   "section": "Filters and wipers",
   "item": "Wipers streaking or chattering. There is no labour charge to fit them."
  },
  {
   "section": "Filters and wipers",
   "item": "Customers know they can buy a filter at the parts store for less. Say so first: \"You can do this one yourself for about half. If you would rather we did it while it is here, it is ten minutes.\""
  }
 ],
