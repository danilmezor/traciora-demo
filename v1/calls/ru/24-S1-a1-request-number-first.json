  "script": [
    {
      "n": 1,
      "who": "advisor",
      "at_s": 0.0,
      "said": "Ермак-Сервис, Алина, доброе утро."
    },
    {
      "n": 2,
      "who": "customer",
      "at_s": 3.2,
      "said": "Алина, доброе. Кравцов. Записывайте: Ларгус, двадцать четвёртый, колодки передние стёрлись, водитель говорит — скрежещет уже."
    },
    {
      "n": 3,
      "who": "advisor",
      "at_s": 9.7,
      "said": "Так.",
      "overlap": true
    },
    {
      "n": 4,
      "who": "advisor",
      "at_s": 11.5,
      "said": "Олег Вячеславович, здравствуйте. Записываю. Только сначала номер заявки продиктуйте, пожалуйста, — чтобы у нас счёт потом без него не ушёл."
    },
    {
      "n": 5,
      "who": "customer",
      "at_s": 22.3,
      "said": "О, научились. Сейчас... э-э... Двести сорок семь дробь десять."
    },
    {
      "n": 6,
      "who": "advisor",
      "at_s": 28.0,
      "said": "Двести сорок семь дробь десять, есть. Ларгус двадцать четвёртый — это эр триста пятьдесят восемь тэ-эн?"
    },
    {
      "n": 7,
      "who": "customer",
      "at_s": 36.5,
      "said": "Он."
    },
    {
      "n": 8,
      "who": "advisor",
      "at_s": 38.1,
      "said": "А скрежет давно? Диски не задрало, водитель не смотрел?"
    },
    {
      "n": 9,
      "who": "customer",
      "at_s": 43.4,
      "said": "Дня два, говорит. Диски — не знаю, вы гляньте."
    },
    {
      "n": 10,
      "who": "advisor",
      "at_s": 48.7,
      "said": "Поняла, мастер замерит. Если диски под замену — я вам сначала позвоню с суммой. Могу принять сегодня в два."
    },
    {
      "n": 11,
      "who": "customer",
      "at_s": 57.2,
      "said": "Угу.",
      "overlap": true
    },
    {
      "n": 12,
      "who": "customer",
      "at_s": 58.9,
      "said": "В два — годится, он как раз с маршрута вернётся."
    },
    {
      "n": 13,
      "who": "advisor",
      "at_s": 65.0,
      "said": "Записала: сегодня, четырнадцать ноль-ноль, Ларгус двадцать четвёртый, принимаю я."
    },
    {
      "n": 14,
      "who": "customer",
      "at_s": 70.4,
      "said": "И сразу скажите, когда заберём."
    },
    {
      "n": 15,
      "who": "advisor",
      "at_s": 73.9,
      "said": "Если только колодки — через час отдадим. Значит, сегодня в два, передние колодки, заявка двести сорок семь дробь десять. По дискам отзвонюсь."
    },
    {
      "n": 16,
      "who": "customer",
      "at_s": 86.4,
      "said": "Добро. Спасибо."
    },
    {
      "n": 17,
      "who": "advisor",
      "at_s": 88.1,
      "said": "Спасибо, Олег Вячеславович, до свидания!"
