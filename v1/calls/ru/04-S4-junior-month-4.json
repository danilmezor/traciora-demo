  "script": [
    {
      "n": 1,
      "who": "advisor",
      "at_s": 0.0,
      "said": "Ермак-Сервис, Алина, добрый день."
    },
    {
      "n": 2,
      "who": "customer",
      "at_s": 3.0,
      "said": "Здравствуйте. Девушка, у меня стучит что-то спереди. Можно к вам приехать, посмотреть?"
    },
    {
      "n": 3,
      "who": "advisor",
      "at_s": 10.7,
      "said": "Конечно, посмотрим. Какая у вас машина?"
    },
    {
      "n": 4,
      "who": "customer",
      "at_s": 14.8,
      "said": "Фольксваген Поло, седан. Шестнадцатого года."
    },
    {
      "n": 5,
      "who": "advisor",
      "at_s": 18.5,
      "said": "Поло, шестнадцатый... А стучит как — на кочках или когда руль поворачиваете?"
    },
    {
      "n": 6,
      "who": "customer",
      "at_s": 25.0,
      "said": "Ой, я не знаю, как объяснить. Ну вот едешь по двору, по ямкам — и так: тук-тук. Глухо так."
    },
    {
      "n": 7,
      "who": "advisor",
      "at_s": 33.6,
      "said": "Угу.",
      "overlap": true
    },
    {
      "n": 8,
      "who": "advisor",
      "at_s": 35.6,
      "said": "На неровностях, значит. А справа, слева — не понять?"
    },
    {
      "n": 9,
      "who": "customer",
      "at_s": 40.7,
      "said": "По-моему, справа. Где пассажир."
    },
    {
      "n": 10,
      "who": "advisor",
      "at_s": 44.0,
      "said": "Угу. И давно?"
    },
    {
      "n": 11,
      "who": "customer",
      "at_s": 46.5,
      "said": "Недели две. Сначала думала, в багажнике что-то катается."
    },
    {
      "n": 12,
      "who": "advisor",
      "at_s": 51.8,
      "said": "Поняла. Скорее всего, м-м, что-то по подвеске — стойки стабилизатора, например, но это мастер должен на подъёмнике смотреть. Давайте я вас запишу. Как вас зовут?"
    },
    {
      "n": 13,
      "who": "customer",
      "at_s": 63.5,
      "said": "Ага.",
      "overlap": true
    },
    {
      "n": 14,
      "who": "customer",
      "at_s": 65.1,
      "said": "Наталья. Ефимова."
    },
    {
      "n": 15,
      "who": "advisor",
      "at_s": 67.2,
      "said": "Наталья, и телефон продиктуйте, пожалуйста."
    },
    {
      "n": 16,
      "who": "customer",
      "at_s": 70.3,
      "said": "Девятьсот семь, восемьсот тридцать, шестьдесят шесть, восемьдесят."
    },
    {
      "n": 17,
      "who": "advisor",
      "at_s": 75.1,
      "said": "Ага, записала. Могу принять вас завтра в одиннадцать."
    },
    {
      "n": 18,
      "who": "customer",
      "at_s": 80.0,
      "said": "Завтра... А сколько это стоит — посмотреть?"
    },
    {
      "n": 19,
      "who": "advisor",
      "at_s": 83.8,
      "said": "Диагностика ходовой — восемьсот рублей."
    },
    {
      "n": 20,
      "who": "customer",
      "at_s": 87.2,
      "said": "Восемьсот? Только за то, чтобы посмотреть? Дорого как-то."
    },
    {
      "n": 21,
      "who": "advisor",
      "at_s": 92.3,
      "said": "Я вас понимаю, сейчас всё недёшево... Но зато будете точно знать, что стучит."
    },
    {
      "n": 22,
      "who": "customer",
      "at_s": 98.2,
      "said": "Мгм.",
      "overlap": true
    },
    {
      "n": 23,
      "who": "customer",
      "at_s": 100.4,
      "said": "Ну да... Ладно, давайте завтра."
    },
    {
      "n": 24,
      "who": "advisor",
      "at_s": 104.3,
      "said": "Хорошо! Записала: завтра, одиннадцать ноль-ноль, принимаю я, Алина."
    },
    {
      "n": 25,
      "who": "customer",
      "at_s": 109.5,
      "said": "А ждать долго?"
    },
    {
      "n": 26,
      "who": "advisor",
      "at_s": 112.3,
      "said": "Минут тридцать, мастер при вас посмотрит и всё покажет."
    },
    {
      "n": 27,
      "who": "customer",
      "at_s": 118.4,
      "said": "Хорошо."
    },
    {
      "n": 28,
      "who": "advisor",
      "at_s": 120.6,
      "said": "Значит, завтра в одиннадцать, Поло, диагностика ходовой. Ждём вас, Наталья!"
    },
