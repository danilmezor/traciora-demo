  "script": [
    {
      "n": 1,
      "who": "advisor",
      "at_s": 0.0,
      "said": "Ермак-Сервис, Алина, добрый день."
    },
    {
      "n": 2,
      "who": "customer",
      "at_s": 3.2,
      "said": "Добрый. Скажите, масло в коробке вы меняете? В автомате."
    },
    {
      "n": 3,
      "who": "advisor",
      "at_s": 8.5,
      "said": "Меняем, да. А машина какая у вас?"
    },
    {
      "n": 4,
      "who": "customer",
      "at_s": 12.9,
      "said": "Мазда тройка, двенадцатого года."
    },
    {
      "n": 5,
      "who": "advisor",
      "at_s": 16.0,
      "said": "Мазда три... А пробег какой сейчас?"
    },
    {
      "n": 6,
      "who": "customer",
      "at_s": 19.8,
      "said": "Сто тридцать пять."
    },
    {
      "n": 7,
      "who": "advisor",
      "at_s": 22.2,
      "said": "А в коробке масло раньше меняли, не знаете?"
    },
    {
      "n": 8,
      "who": "customer",
      "at_s": 27.5,
      "said": "Вот не знаю. Я её с пробегом брал, по книжке — ничего нет. Потому и хочу."
    },
    {
      "n": 9,
      "who": "advisor",
      "at_s": 34.5,
      "said": "Ага.",
      "overlap": true
    },
    {
      "n": 10,
      "who": "advisor",
      "at_s": 36.2,
      "said": "Понятно. Э-э, смотрите, тогда есть два варианта. Частичная замена — это шесть девятьсот, с маслом. И полная, аппаратная, — шестнадцать триста."
    },
    {
      "n": 11,
      "who": "customer",
      "at_s": 45.3,
      "said": "Угу.",
      "overlap": true
    },
    {
      "n": 12,
      "who": "advisor",
      "at_s": 47.4,
      "said": "Если масло ни разу не меняли на таком пробеге, мастера обычно советуют частичную, а через тысячу километров ещё раз. Но это он на месте скажет, по состоянию масла."
    },
    {
      "n": 13,
      "who": "customer",
      "at_s": 61.2,
      "said": "Ага.",
      "overlap": true
    },
    {
      "n": 14,
      "who": "customer",
      "at_s": 62.9,
      "said": "Шесть девятьсот, значит. А по времени это сколько?"
    },
    {
      "n": 15,
      "who": "advisor",
      "at_s": 67.6,
      "said": "Частичная — около часа, можно у нас подождать."
    },
    {
      "n": 16,
      "who": "customer",
      "at_s": 72.4,
      "said": "Ясно."
    },
    {
      "n": 17,
      "who": "advisor",
      "at_s": 74.5,
      "said": "Давайте я вас в базу занесу, чтобы расчёт остался. Как вас зовут?"
    },
    {
      "n": 18,
      "who": "customer",
      "at_s": 81.7,
      "said": "Виктор."
    },
    {
      "n": 19,
      "who": "advisor",
      "at_s": 83.3,
      "said": "Виктор, а фамилию подскажете?"
    },
    {
      "n": 20,
      "who": "customer",
      "at_s": 86.0,
      "said": "Лаптев."
    },
    {
      "n": 21,
      "who": "advisor",
      "at_s": 87.8,
      "said": "И номер телефона для связи."
    },
    {
      "n": 22,
      "who": "customer",
      "at_s": 91.3,
      "said": "Девятьсот семь, шестьсот один, восемьдесят четыре, двадцать два."
    },
    {
      "n": 23,
      "who": "advisor",
      "at_s": 96.1,
      "said": "Ага, записала. Виктор, давайте запишу вас на замену — когда вам удобно было бы подъехать?"
    },
    {
      "n": 24,
      "who": "customer",
      "at_s": 104.5,
      "said": "Ой... Не знаю пока. Я подумаю ещё, тогда наберу."
    },
    {
      "n": 25,
      "who": "advisor",
      "at_s": 109.8,
      "said": "Хорошо, конечно. Если что — звоните, я сегодня до восьми."
    },
    {
      "n": 26,
      "who": "customer",
      "at_s": 115.5,
      "said": "Ладно, спасибо."
    },
    {
      "n": 27,
